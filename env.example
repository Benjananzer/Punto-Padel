# Connection string de Neon (Dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Cadena larga y aleatoria para firmar sesiones (ej: openssl rand -hex 32)
AUTH_SECRET=cambiame
# Quien se registre con estos correos queda como administrador / dueño
ADMIN_EMAIL=admin@tudominio.com
OWNER_EMAIL=dueno@tudominio.com
